# API
API_KEY=change-me

# AWS S3 - Logs
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY se leen automáticamente del entorno / IAM Role
LOG_S3_BUCKET=mi-bucket-de-logs
LOG_S3_PREFIX=api-logs

# Google BigQuery (producción)
BIGQUERY_PROJECT_ID=mi-proyecto-gcp
BIGQUERY_DATASET=mi_dataset
GCP_CLIENT_EMAIL=service-account@proyecto.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Desarrollo local
USE_MOCK=true

# IP Whitelist (opcional)
ENABLE_IP_WHITELIST=false
ALLOWED_IPS=127.0.0.1,10.0.0.1
